#!/usr/bin/env bash
# select-cluster — pick and persist the active cluster directory.
#
# Usage (from workspace root):
#   select-cluster               # interactive fzf picker
#   select-cluster <path>        # set directly (relative or absolute)
#   select-cluster --current     # print the currently selected path
#
# Persists to .vscode/.selected-cluster and updates the VS Code window title
# in .vscode/settings.json so the cluster name is always visible.
set -euo pipefail

WORKSPACE="${WORKSPACE_FOLDER:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
PERSIST_FILE="${WORKSPACE}/.vscode/.selected-cluster"
SETTINGS_FILE="${WORKSPACE}/.vscode/settings.json"

if [[ "${1:-}" == "--current" ]]; then
  if [[ -f "${PERSIST_FILE}" ]]; then
    cat "${PERSIST_FILE}"
  else
    echo "<none>"
  fi
  exit 0
fi

if [[ $# -eq 0 ]]; then
  mapfile -t CLUSTERS < <(
    {
      # Individual terragrunt units: single-node clusters, and each unit
      # (control-plane, node-pools/<pool>) of a multi-node cluster. Pick one of
      # these for per-node verbs (kube-kubeconfig/kube-status/kube-shell).
      find "${WORKSPACE}/live" -path "*/clusters/*" -name terragrunt.hcl \
        -not -path "*/.terragrunt-cache/*" \
        -not -path "*/.terraform/*" \
        -print 2>/dev/null \
        | sed 's|/terragrunt.hcl$||'
      # Multi-node cluster roots: a directory directly under clusters/ with no
      # terragrunt.hcl of its own but units beneath it. Pick one of these for
      # the lifecycle verbs, which drive all its units with `terragrunt run --all`.
      find "${WORKSPACE}/live" -type d \
        -not -path "*/.terragrunt-cache/*" \
        -not -path "*/.terraform/*" 2>/dev/null \
        | while IFS= read -r d; do
            [[ "$(basename "$(dirname "$d")")" == "clusters" ]] || continue
            [[ -f "$d/terragrunt.hcl" ]] && continue
            find "$d" -mindepth 2 -name terragrunt.hcl -not -path '*/.terragrunt-cache/*' -print -quit 2>/dev/null \
              | grep -q . && printf '%s\n' "$d"
          done
    } \
      | sed "s|${WORKSPACE}/||" \
      | sort -u
  )

  if [[ ${#CLUSTERS[@]} -eq 0 ]]; then
    echo "Error: no clusters found under ${WORKSPACE}/live" >&2
    exit 1
  fi

  # If a cluster is already selected, put it first so it's the default fzf
  # cursor position (pressing Enter with no input re-selects it) instead of
  # forgetting the previous choice every time the picker opens.
  CURRENT=""
  if [[ -f "${PERSIST_FILE}" ]]; then
    CURRENT="$(cat "${PERSIST_FILE}")"
    CURRENT="${CURRENT#"${WORKSPACE}"/}"
  fi
  if [[ -n "${CURRENT}" ]]; then
    for c in "${CLUSTERS[@]}"; do
      if [[ "${c}" == "${CURRENT}" ]]; then
        REORDERED=("${CURRENT}")
        for c2 in "${CLUSTERS[@]}"; do
          [[ "${c2}" != "${CURRENT}" ]] && REORDERED+=("${c2}")
        done
        CLUSTERS=("${REORDERED[@]}")
        break
      fi
    done
  fi

  TARGET=$(printf '%s\n' "${CLUSTERS[@]}" \
    | fzf --prompt="Select cluster: " --height=10 --border \
          --header="${CURRENT:+current: ${CURRENT}}" \
          --bind='left-click:accept') || {
    echo "No cluster selected." >&2
    exit 1
  }
  TARGET="${WORKSPACE}/${TARGET}"
else
  TARGET="$1"
  if [[ "${TARGET}" != /* ]]; then
    TARGET="${WORKSPACE}/${TARGET}"
  fi
fi

if [[ ! -f "${TARGET}/terragrunt.hcl" ]] \
   && ! find "${TARGET}" -mindepth 2 -name terragrunt.hcl -not -path '*/.terragrunt-cache/*' -print -quit 2>/dev/null | grep -q .; then
  echo "Error: '${TARGET}' is neither a terragrunt unit nor a multi-node cluster root" >&2
  exit 1
fi

ABS="$(cd "${TARGET}" && pwd)"
# Display the path under clusters/ (e.g. "cluster-2" or "cluster-2/control-plane")
# so a selected subunit isn't shown as a bare "control-plane".
if [[ "${ABS}" == */clusters/* ]]; then
  CLUSTER_NAME="${ABS##*/clusters/}"
else
  CLUSTER_NAME="$(basename "${ABS}")"
fi
WORKSPACE_NAME="$(basename "${WORKSPACE}")"

mkdir -p "${WORKSPACE}/.vscode"
echo "${ABS}" > "${PERSIST_FILE}"

TITLE="${WORKSPACE_NAME} [${CLUSTER_NAME}] \${separator}\${appName}"
if [[ -f "${SETTINGS_FILE}" ]]; then
  TMP="$(mktemp)"
  jq --arg t "${TITLE}" '. + {"window.title": $t}' "${SETTINGS_FILE}" > "${TMP}"
  mv "${TMP}" "${SETTINGS_FILE}"
else
  jq -n --arg t "${TITLE}" '{"window.title": $t}' > "${SETTINGS_FILE}"
fi

echo "Selected: ${CLUSTER_NAME} (${ABS})"
