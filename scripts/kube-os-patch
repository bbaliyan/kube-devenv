#!/usr/bin/env bash
# kube-os-patch — patch the OS on every node of the selected cluster, via
# kube-examples' ops/upgrade-os.sh (which applies the cluster's os-patch/
# terragrunt unit — kube-compute's node-os-patch module — and runs the
# resulting Ansible playbook): dnf update -y on each node, reboot only when
# dnf needs-restarting -r actually says one is needed. Control-plane nodes
# patch one at a time (etcd quorum tolerates losing at most one at a time);
# workers patch after, with no such restriction.
#
# Proxmox only today — node-os-patch's Proxmox transport is SSH (same
# account/key node-bootstrap itself connects with), and no os-patch/ unit
# exists for AWS/Azure clusters yet.
#
# Run from the cluster directory (live/proxmox/clusters/<name>/ or any of its
# units) — same as kube-apply/kube-destroy, typed cluster-name confirmation
# since this can reboot every node in the cluster.
set -euo pipefail
source kube-common.sh

CLUSTER_DIR="$(pwd)"
CLUSTER=$(cluster_name_from_pwd)
PROVIDER=$(cluster_provider "${CLUSTER_DIR}")

if [[ "${PROVIDER}" != "proxmox" ]]; then
  echo "Error: kube-os-patch only supports Proxmox today (got provider '${PROVIDER}')." >&2
  echo "  No os-patch/ terragrunt unit exists for AWS/Azure clusters yet." >&2
  exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
SCRIPT="${REPO_ROOT}/ops/upgrade-os.sh"

if [[ ! -f "${SCRIPT}" ]]; then
  echo "Error: ${SCRIPT} not found — is the cwd inside a kube-examples checkout?" >&2
  exit 1
fi

echo "About to patch every node of cluster '${CLUSTER}' — control-plane one at a time, then workers."
echo "Nodes will reboot if (and only if) a patch actually requires it."
echo -n "Type '${CLUSTER}' to confirm: "
read -r CONFIRM

if [[ "${CONFIRM}" != "${CLUSTER}" ]]; then
  echo "Confirmation did not match. Aborting." >&2
  exit 1
fi

exec "${SCRIPT}" "${CLUSTER}" "$@"
