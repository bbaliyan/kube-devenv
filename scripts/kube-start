#!/usr/bin/env bash
# kube-start — start stopped nodes: one, or every node of the cluster.
# Run from the cluster directory (live/<provider>/clusters/<name>/). Prompts
# to pick a node, or all of them, when there's more than one.
set -euo pipefail
source kube-common.sh

terragrunt_outputs
NODE_PROVIDER=$(echo "${TF_OUTPUTS}" | jq -r '.node_provider.value')

NODES=$(select_nodes "${TF_OUTPUTS}")
mapfile -t INSTANCE_IDS < <(echo "${NODES}" | jq -r '.instance_id')
echo "Starting $(echo "${NODES}" | jq -r '.name' | paste -sd' ')..."

case "${NODE_PROVIDER}" in

  aws)
    AWS_REGION=$(echo "${TF_OUTPUTS}" | jq -r '.aws_region.value')
    aws ec2 start-instances --instance-ids "${INSTANCE_IDS[@]}" --region "${AWS_REGION}" \
      --query 'StartingInstances[].[InstanceId,CurrentState.Name]' --output text
    ;;

  azure)
    RESOURCE_GROUP=$(echo "${TF_OUTPUTS}" | jq -r '.resource_group_name.value')
    for id in "${INSTANCE_IDS[@]}"; do
      az vm start --resource-group "${RESOURCE_GROUP}" --name "$(basename "${id}")"
    done
    ;;

  proxmox)
    # qm is root-only on PVE (not an ACL grant tofu can be given — it talks
    # to pmxcfs directly), so this uses the same root SSH access as
    # kube-proxmox-login, not the tofu ops user.
    PROXMOX_HOST=$(proxmox_host)
    for id in "${INSTANCE_IDS[@]}"; do
      ssh "${PROXMOX_ROOT_SSH_USER:-root}@${PROXMOX_HOST}" "/usr/sbin/qm start ${id}"
    done
    ;;

  *)
    echo "Error: unknown node_provider '${NODE_PROVIDER}'" >&2
    exit 1
    ;;
esac
