#!/usr/bin/env bash
# kube-plan — terragrunt plan for the selected cluster. Handles a single
# terragrunt unit (single-node cluster) and a multi-node cluster root, which is
# planned across all its units with `terragrunt run --all`.
# Run from the cluster directory (live/<provider>/clusters/<name>[/<unit>]/).
set -euo pipefail
source kube-common.sh

case "$(terragrunt_run_mode)" in
  single) terragrunt plan "$@" ;;
  all)    terragrunt run --all -- plan "$@" ;;
  *)
    echo "Error: '$(pwd)' is neither a terragrunt unit nor a multi-node cluster root." >&2
    exit 1
    ;;
esac
