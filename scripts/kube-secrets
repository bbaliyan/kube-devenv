#!/usr/bin/env bash
# kube-secrets — print in-cluster secrets (kubeconfig must already be fetched).
# Run from the cluster directory (live/<provider>/clusters/<name>/).
set -euo pipefail

CLUSTER_NAME=$(basename "$(pwd)")
KUBECONFIG_PATH="${HOME}/.kube/${CLUSTER_NAME}.yaml"

if [[ ! -f "${KUBECONFIG_PATH}" ]]; then
  echo "Error: kubeconfig not found at ${KUBECONFIG_PATH}" >&2
  echo "Run 'kube-kubeconfig' first." >&2
  exit 1
fi

export KUBECONFIG="${KUBECONFIG_PATH}"

echo "=== ArgoCD initial admin password ==="
kubectl -n argocd get secret argocd-initial-admin-secret \
  -o jsonpath='{.data.password}' 2>/dev/null | base64 -d && echo || echo "(not found)"
