#!/usr/bin/env bash
# kube-secrets — print in-cluster secrets (kubeconfig must already be fetched).
# Run from the cluster directory (live/<provider>/clusters/<name>/).
set -euo pipefail
source kube-common.sh

resolve_control_plane_unit
terragrunt_outputs
KUBECONFIG_PATH="${HOME}/.kube/$(kubeconfig_stem "${TF_OUTPUTS}").yaml"

if [[ ! -f "${KUBECONFIG_PATH}" ]]; then
  echo "Error: kubeconfig not found at ${KUBECONFIG_PATH}" >&2
  echo "Run 'kube-kubeconfig' first." >&2
  exit 1
fi

export KUBECONFIG="${KUBECONFIG_PATH}"

echo "=== ArgoCD initial admin password (user: admin) ==="
kubectl -n argocd get secret argocd-initial-admin-secret \
  -o jsonpath='{.data.password}' 2>/dev/null | base64 -d && echo || echo "(not found)"

echo ""
echo "=== Grafana admin password (user: admin) ==="
# Generated once by External Secrets. Grafana reads it only when its database is first created.
kubectl -n prometheus get secret grafana-admin \
  -o jsonpath='{.data.password}' 2>/dev/null | base64 -d && echo || echo "(not found)"

echo ""
echo "=== Headlamp login token (paste into Headlamp's token prompt) ==="
# Headlamp authenticates with a service-account token, not a password. The
# headlamp-admin-token secret (type kubernetes.io/service-account-token) is
# populated by the token controller with a JWT for the headlamp-admin SA.
kubectl -n headlamp get secret headlamp-admin-token \
  -o jsonpath='{.data.token}' 2>/dev/null | base64 -d && echo || echo "(not found)"
