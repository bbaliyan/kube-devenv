#!/usr/bin/env bash
# kube-secrets — print in-cluster secrets (kubeconfig must already be fetched).
# Run from the cluster directory (live/<provider>/clusters/<name>/).
set -euo pipefail
source kube-common.sh

CLUSTER_NAME=$(cluster_name_from_pwd)
# kube-kubeconfig names the file "<cluster>.yaml" or, for providers with a
# region concept, "<cluster>-<region>.yaml" (so same-named clusters in
# different regions get separate files) — match by prefix rather than
# assuming which form applies here.
shopt -s nullglob
KUBECONFIG_MATCHES=("${HOME}"/.kube/"${CLUSTER_NAME}"*.yaml)
shopt -u nullglob

case "${#KUBECONFIG_MATCHES[@]}" in
  0)
    echo "Error: no kubeconfig found for '${CLUSTER_NAME}' in ${HOME}/.kube/" >&2
    echo "Run 'kube-kubeconfig' first." >&2
    exit 1
    ;;
  1)
    KUBECONFIG_PATH="${KUBECONFIG_MATCHES[0]}"
    ;;
  *)
    echo "Error: multiple kubeconfigs match '${CLUSTER_NAME}*' in ${HOME}/.kube/:" >&2
    printf '  %s\n' "${KUBECONFIG_MATCHES[@]}" >&2
    echo "Set KUBECONFIG explicitly to the one you want." >&2
    exit 1
    ;;
esac

export KUBECONFIG="${KUBECONFIG_PATH}"

echo "=== ArgoCD initial admin password (user: admin) ==="
kubectl -n argocd get secret argocd-initial-admin-secret \
  -o jsonpath='{.data.password}' 2>/dev/null | base64 -d && echo || echo "(not found)"

echo ""
echo "=== Grafana admin password (user: admin) ==="
# kube-prometheus-stack stores Grafana's generated admin password in the
# prometheus-grafana secret. The observability app pins it via ignoreDifferences
# so it stays stable across syncs.
kubectl -n prometheus get secret prometheus-grafana \
  -o jsonpath='{.data.admin-password}' 2>/dev/null | base64 -d && echo || echo "(not found)"

echo ""
echo "=== Headlamp login token (paste into Headlamp's token prompt) ==="
# Headlamp authenticates with a service-account token, not a password. The
# headlamp-admin-token secret (type kubernetes.io/service-account-token) is
# populated by the token controller with a JWT for the headlamp-admin SA.
kubectl -n headlamp get secret headlamp-admin-token \
  -o jsonpath='{.data.token}' 2>/dev/null | base64 -d && echo || echo "(not found)"
