#!/usr/bin/env bash
# kube-secrets — print in-cluster secrets (kubeconfig must already be fetched).
# Run from the cluster directory (live/<provider>/clusters/<name>/).
set -euo pipefail
source kube-common.sh

CLUSTER_NAME=$(cluster_name_from_pwd)
KUBECONFIG_PATH="${HOME}/.kube/${CLUSTER_NAME}.yaml"

if [[ ! -f "${KUBECONFIG_PATH}" ]]; then
  echo "Error: kubeconfig not found at ${KUBECONFIG_PATH}" >&2
  echo "Run 'kube-kubeconfig' first." >&2
  exit 1
fi

export KUBECONFIG="${KUBECONFIG_PATH}"

echo "=== ArgoCD initial admin password (user: admin) ==="
kubectl -n argocd get secret argocd-initial-admin-secret \
  -o jsonpath='{.data.password}' 2>/dev/null | base64 -d && echo || echo "(not found)"

echo ""
echo "=== Grafana admin password (user: admin) ==="
# kube-prometheus-stack stores Grafana's generated admin password in the
# prometheus-grafana secret. The observability app pins it via ignoreDifferences
# so it stays stable across syncs.
kubectl -n prometheus get secret prometheus-grafana \
  -o jsonpath='{.data.admin-password}' 2>/dev/null | base64 -d && echo || echo "(not found)"
