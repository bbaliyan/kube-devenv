#!/usr/bin/env bash
# kube-status — read bootstrap status from the node.
# AWS/Azure use an inbound-port-free control-plane primitive (SSM /
# run-command); Proxmox uses direct SSH to the VM (requires port 22 open to
# the node — see live/proxmox/README.md).
# Run from the cluster directory (live/<provider>/clusters/<name>/).
set -euo pipefail
source kube-common.sh

terragrunt_outputs
NODE_PROVIDER=$(echo "${TF_OUTPUTS}" | jq -r '.node_provider.value')
STATUS_REF=$(echo "${TF_OUTPUTS}"   | jq -r '.bootstrap_status_ref.value')

case "${NODE_PROVIDER}" in

  proxmox)
    CLUSTER_IP=$(echo "${TF_OUTPUTS}" | jq -r '.cluster_ip.value')
    VM_SSH_KEY=$(proxmox_vm_ssh_key)
    VM_SSH_USER=$(proxmox_vm_ssh_user)
    ssh -i "${VM_SSH_KEY}" -o StrictHostKeyChecking=accept-new \
        "${VM_SSH_USER}@${CLUSTER_IP}" \
        "cat /var/log/kube-compute/bootstrap-status 2>/dev/null || echo 'not-started'"
    ;;

  aws)
    # STATUS_REF = EC2 instance ID. Uses SSM (no inbound port).
    aws ssm send-command \
      --instance-ids "${STATUS_REF}" \
      --document-name "AWS-RunShellScript" \
      --parameters 'commands=["cat /var/log/kube-compute/bootstrap-status 2>/dev/null || echo not-started"]' \
      --query "Command.CommandId" --output text \
      | xargs -I{} aws ssm get-command-invocation \
          --instance-id "${STATUS_REF}" --command-id {} \
          --query "StandardOutputContent" --output text
    ;;

  azure)
    # STATUS_REF = full Azure VM resource ID.
    RESOURCE_GROUP=$(echo "${TF_OUTPUTS}" | jq -r '.resource_group_name.value')
    VM_NAME=$(basename "${STATUS_REF}")
    az vm run-command invoke \
      --resource-group "${RESOURCE_GROUP}" \
      --name "${VM_NAME}" \
      --command-id RunShellScript \
      --scripts "cat /var/log/kube-compute/bootstrap-status 2>/dev/null || echo not-started" \
      --query "value[0].message" --output tsv
    ;;

  *)
    echo "Error: unknown node_provider '${NODE_PROVIDER}'" >&2
    exit 1
    ;;
esac
