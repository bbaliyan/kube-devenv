#!/usr/bin/env bash
# kube-tail — live-tail a node's Ansible bootstrap log while `terragrunt
# apply` runs in another terminal. node-bootstrap mirrors its whole run to
# /tmp/kube-compute-bootstrap-<node_name>.log on this same machine (the one
# running apply) via `tee` — Terraform/OpenTofu itself unconditionally
# suppresses that provisioner's own console output because its config
# touches sensitive values (the cluster tokens), so this is the only way to
# watch live, task-by-task Ansible progress during a run. Works the same way
# for AWS and Proxmox alike — the log is local to whatever machine runs
# apply, not on the remote node itself.
#
# Deliberately does NOT use kube-common.sh's select_node/terragrunt_outputs
# (unlike kube-status/kube-shell): those read
# control_plane_node_refs/worker_node_refs via `terragrunt output`, but
# Terraform only writes root outputs to state after the ENTIRE apply
# finishes — they don't exist yet while a node's bootstrap is still running,
# which is exactly when you want to tail it. This globs for the log files
# node-bootstrap's own local-exec already creates the moment each node's
# Ansible run starts, with no Terraform state dependency at all.
#
# Derives the cluster name from the working directory's path so it works both
# from the cluster directory itself (single-node all-in-one layout,
# live/<provider>/clusters/<name>/) and from a subunit of a multi-node cluster
# (clusters/<name>/control-plane/ or clusters/<name>/node-pools/<pool>/): it
# takes the path segment directly under the nearest `clusters/` ancestor. That
# segment is the cluster_name (Proxmox derives it that way explicitly; AWS's
# hardcoded cluster_name matches its directory name by convention). Falls back
# to the current directory's basename when not under a `clusters/` path.
set -euo pipefail

PWD_PATH="$(pwd)"
if [[ "$PWD_PATH" == */clusters/* ]]; then
  after="${PWD_PATH##*/clusters/}"   # e.g. "cluster-2/control-plane" or "cluster-1"
  CLUSTER_NAME="${after%%/*}"        # -> "cluster-2" or "cluster-1"
else
  CLUSTER_NAME="$(basename "$PWD_PATH")"
fi
LOG_GLOB="/tmp/kube-compute-bootstrap-${CLUSTER_NAME}-"*".log"

echo "Watching for ${CLUSTER_NAME}'s bootstrap log(s) — waiting if none have started yet (Ctrl-C to stop)..."
while true; do
  # shellcheck disable=SC2206  # intentional glob expansion, not word-splitting
  MATCHES=(${LOG_GLOB})
  [[ -e "${MATCHES[0]}" ]] && break
  sleep 1
done

# A multi-node cluster's nodes don't all start bootstrapping at once: node-pool
# workers' local-exec provisioners fire close together but not simultaneously,
# and re-running kube-tail once a node-pool unit starts can catch a leftover
# control-plane log already sitting on disk right as the workers' logs are
# about to appear. Settle briefly after the first match so a lone/stale log
# doesn't get auto-picked before its siblings show up — finalize once no new
# log has appeared for GLOB_SETTLE_ROUNDS polls, capped by GLOB_SETTLE_MAX_ROUNDS
# so a steady trickle of new nodes can't stall this indefinitely.
GLOB_SETTLE_INTERVAL=0.5
GLOB_SETTLE_ROUNDS=4
GLOB_SETTLE_MAX_ROUNDS=20
stable_rounds=0
total_rounds=0
prev_count="${#MATCHES[@]}"
while [[ "${stable_rounds}" -lt "${GLOB_SETTLE_ROUNDS}" && "${total_rounds}" -lt "${GLOB_SETTLE_MAX_ROUNDS}" ]]; do
  sleep "${GLOB_SETTLE_INTERVAL}"
  # shellcheck disable=SC2206  # intentional glob expansion, not word-splitting
  MATCHES=(${LOG_GLOB})
  total_rounds=$((total_rounds + 1))
  if [[ "${#MATCHES[@]}" -gt "${prev_count}" ]]; then
    prev_count="${#MATCHES[@]}"
    stable_rounds=0
  else
    stable_rounds=$((stable_rounds + 1))
  fi
done

if [[ "${#MATCHES[@]}" -eq 1 ]]; then
  LOG="${MATCHES[0]}"
else
  LOG=$(printf '%s\n' "${MATCHES[@]}" | fzf --prompt="Select node log: " --height=10 --border)
fi

echo "Tailing ${LOG}"
tail -F -n +1 "${LOG}"
