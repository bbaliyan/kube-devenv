#!/usr/bin/env bash
# kube-tail — live-tail a node's bootstrap log while `terragrunt apply` runs
# in another terminal, or any time after.
#
# node-bootstrap's cloud-init payload is fire-and-forget: Terraform/OpenTofu
# returns as soon as the payload is attached to the VM, with no visibility
# into whether the node ever actually joins (see node-bootstrap/README.md's
# "Watching progress during a real apply"). The node writes its own progress
# to /var/log/kube-compute-bootstrap.log on itself — that log is the only
# place to watch bootstrap progress, so this reaches it out-of-band the same
# way kube-status/kube-shell reach a node: AWS/Azure via the inbound-port-free
# control-plane primitive (SSM / run-command), Proxmox via direct SSH.
#
# Previously (pre-cloud-init) this watched a local Ansible log this same
# machine wrote via `tee` during `apply` — that file no longer exists now
# that bootstrap runs entirely on the node itself, so this now goes back to
# reading the node's own log remotely instead, same as kube-status/kube-shell.
#
# Run from either a specific unit (live/<provider>/clusters/<name>/[control-plane|
# node-pools/<pool>]/) or a multi-node cluster root (live/<provider>/clusters/<name>/)
# — select_node_any_unit aggregates nodes across every unit in the latter case.
# Prompts to pick a node whenever there's more than one across whatever's in scope.
set -euo pipefail
source kube-common.sh

BOOTSTRAP_LOG=/var/log/kube-compute-bootstrap.log

NODE=$(select_node_any_unit)
NODE_NAME=$(echo "${NODE}" | jq -r '.name')
NODE_IP=$(echo "${NODE}" | jq -r '.ip // empty')
NODE_INSTANCE_ID=$(echo "${NODE}" | jq -r '.instance_id')
NODE_PROVIDER=$(echo "${NODE}" | jq -r '.provider')
NODE_UNIT=$(echo "${NODE}" | jq -r '.unit')
cd "${NODE_UNIT}"

case "${NODE_PROVIDER}" in

  proxmox)
    VM_SSH_KEY=$(proxmox_vm_ssh_key)
    VM_SSH_USER=$(proxmox_vm_ssh_user)
    echo "Tailing ${BOOTSTRAP_LOG} on ${NODE_NAME} (${NODE_IP})..."
    # UserKnownHostsFile=/dev/null: see the identical comment in kube-shell —
    # clusters here are deliberately disposable, so a rotated host key on
    # every destroy/recreate at the same static IP is expected, not
    # suspicious. `tail -F` (not `-f`): survives the log not existing yet
    # (cloud-init may not have created it the instant the VM is reachable
    # over SSH) and a rotation/truncation mid-watch.
    ssh -i "${VM_SSH_KEY}" -t -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null \
        "${VM_SSH_USER}@${NODE_IP}" \
        "tail -F -n +1 ${BOOTSTRAP_LOG}"
    ;;

  aws)
    AWS_REGION=$(terragrunt output -raw aws_region)
    echo "Tailing ${BOOTSTRAP_LOG} on ${NODE_NAME} (${NODE_INSTANCE_ID}) in ${AWS_REGION}..."
    # AWS-StartInteractiveCommand: an AWS-managed SSM document that runs a
    # single command through Session Manager and streams its output live,
    # instead of dropping into an interactive shell — the SSM equivalent of
    # `ssh ... tail -F`. Session Manager has no "just stream a file" verb of
    # its own, so this is the standard way to get one.
    aws ssm start-session --target "${NODE_INSTANCE_ID}" --region "${AWS_REGION}" \
      --document-name "AWS-StartInteractiveCommand" \
      --parameters "command=tail -F -n +1 ${BOOTSTRAP_LOG}"
    ;;

  azure)
    RESOURCE_GROUP=$(terragrunt output -raw resource_group_name)
    VM_NAME=$(basename "${NODE_INSTANCE_ID}")
    echo "Fetching ${BOOTSTRAP_LOG} from ${NODE_NAME} (${VM_NAME})..."
    echo "(Azure run-command is non-interactive — this is a one-shot snapshot, not a live tail;" >&2
    echo " re-run to refresh, or use 'az serial-console' for a live session.)" >&2
    az vm run-command invoke \
      --resource-group "${RESOURCE_GROUP}" \
      --name "${VM_NAME}" \
      --command-id RunShellScript \
      --scripts "tail -n 200 ${BOOTSTRAP_LOG} 2>/dev/null || echo '${BOOTSTRAP_LOG} does not exist yet'" \
      --query "value[0].message" --output tsv
    ;;

  *)
    echo "Error: unknown node_provider '${NODE_PROVIDER}'" >&2
    exit 1
    ;;
esac
