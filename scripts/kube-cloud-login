#!/usr/bin/env bash
# kube-cloud-login — authenticate (or refresh a short-lived session) against the
# selected folder's cloud provider: AWS SSO, Azure CLI, or a Proxmox API
# token refresh over SSH.
#
# The provider is the folder right below live/ (live/<provider>/...), not
# terragrunt output — this has to work *before* the first 'terragrunt init',
# when no state or output exists yet.
set -euo pipefail
source kube-common.sh

FOLDER_DIR=$(selected_folder_dir)
PROVIDER=$(cd "${FOLDER_DIR}" && target_provider)

case "${PROVIDER}" in

  aws)
    echo "Refreshing AWS SSO session (profile: ${AWS_PROFILE:-default})..."
    aws sso login
    ;;

  azure)
    echo "Logging in to Azure..."
    az login
    if [[ -n "${ARM_SUBSCRIPTION_ID:-}" ]]; then
      az account set --subscription "${ARM_SUBSCRIPTION_ID}"
    fi
    ;;

  proxmox)
    exec kube-proxmox-login
    ;;

  *)
    echo "Error: unknown provider '${PROVIDER}' for folder '${FOLDER_DIR}'" >&2
    exit 1
    ;;

esac
