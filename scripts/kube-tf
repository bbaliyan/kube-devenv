#!/usr/bin/env bash
# kube-tf — init, plan, apply or destroy the folder you are in. It picks the tool
# from the files in the folder (see target_mode in kube-common.sh):
#   terragrunt.hcl        terragrunt <verb>
#   terragrunt.stack.hcl  terragrunt stack run <verb>
#   units below           terragrunt run --all -- <verb>
#   only *.tf             tofu <verb>
# It reads files only. Apply and destroy ask you to type the path below live/.
#
# Usage (from the folder, or through kube-run):
#   kube-tf init|plan|apply|destroy [tool arguments...]
#
# --backend-bootstrap: Terragrunt no longer auto-creates a missing backend (for
# example the state S3 bucket) on plain init. Without it, init also fails
# resolving any `dependency` block, since each one is fetched through its own
# fresh, uninitialized working copy.
# -auto-approve skips the tool's own plan prompt, so run 'kube-tf plan' first to
# review the change. The typed confirmation is the one deliberate gate. For
# `run --all` and `stack run`, --non-interactive silences Terragrunt's own
# run-queue prompt. A stack run adds -auto-approve to apply and destroy itself,
# and a bare -auto-approve there fails.
#
# Stale stack units: Terragrunt regenerates the units a stack file defines, but never
# deletes the folder of a unit that was removed from the file or moved. A stack run then
# runs that old folder too. Before init, plan or apply in stack mode, this script
# generates the stack once in a scratch copy and compares the unit folders. If a folder
# on disk is extra, it stops and lists it. It never deletes. Destroy is not blocked,
# because a destroy must reach every unit that exists on disk.
set -euo pipefail
source kube-common.sh

VERB="${1:-}"
case "${VERB}" in
  init | plan | apply | destroy) shift ;;
  *)
    echo "Usage: kube-tf init|plan|apply|destroy [tool arguments...]" >&2
    exit 2
    ;;
esac

MODE=$(target_mode)
if [[ "${MODE}" == none ]]; then
  echo "Error: '$(pwd)' has no terragrunt.hcl, no terragrunt.stack.hcl, no units below it and no .tf files." >&2
  exit 1
fi

# Ansible's profile_tasks callback prints each task's duration as it runs plus a
# longest-first summary at the end; timer adds total playbook runtime. It only
# takes effect for Proxmox, where node-bootstrap runs ansible-playbook as a
# direct child of this shell. An operator who already sets
# ANSIBLE_CALLBACKS_ENABLED keeps their own value.
export ANSIBLE_CALLBACKS_ENABLED="${ANSIBLE_CALLBACKS_ENABLED:-timer,profile_tasks}"

# unit_folders <dir>: the folders below <dir> that Terragrunt generated as units, sorted.
# A generated folder holds a terragrunt.hcl and a .terragrunt-stack-manifest. This also
# finds units that sit outside .terragrunt-stack (no_dot_terragrunt_stack) and units of
# nested stacks. A unit that you committed has no manifest and is not listed.
unit_folders() {
  local d
  while IFS= read -r d; do
    [[ -f "${d}/.terragrunt-stack-manifest" ]] && echo "${d#./}"
  done < <(cd "$1" && find . \( -name .terragrunt-cache -o -name .terraform -o -name .git \) -prune \
    -o -name terragrunt.hcl -printf '%h\n') | LC_ALL=C sort
}

# stale_stack_units: print the generated unit folders that the stack file no longer
# defines. It generates the stack in a scratch copy and compares the two. The copy is a
# sibling folder, so relative sources in the stack file resolve the same way. It has
# another name, so a unit path that uses the stack folder's name differs. A generate
# error stops the script with the real error.
stale_stack_units() {
  local status=0
  PROBE_LOG=$(mktemp) || { echo "Error: cannot create a scratch file." >&2; return 1; }
  PROBE=$(mktemp -d "$(pwd)/../.kube-tf-probe.XXXXXX") || {
    rm -f "${PROBE_LOG}"
    echo "Error: cannot create a scratch folder next to $(pwd)." >&2
    return 1
  }
  trap 'rm -rf "${PROBE}"; rm -f "${PROBE_LOG}"' EXIT
  find . -mindepth 1 -maxdepth 1 -not -name .terragrunt-stack -not -name .terragrunt-cache \
    -not -name .terraform -exec cp -R {} "${PROBE}/" \;
  # Drop the generated folders that the copy brought along: generate must make them again.
  find "${PROBE}" -name .terragrunt-stack-manifest -printf '%h\0' | xargs -0 -r rm -rf
  if (cd "${PROBE}" && terragrunt stack generate --non-interactive) >"${PROBE_LOG}" 2>&1; then
    comm -13 <(unit_folders "${PROBE}") <(unit_folders .) || status=$?
  else
    cat "${PROBE_LOG}" >&2
    echo "Error: cannot generate the stack to compare its units." >&2
    status=1
  fi
  return "${status}"
}

if [[ "${MODE}" == stack ]]; then
  STALE=$(stale_stack_units) || exit 1
  if [[ -n "${STALE}" && "${VERB}" == destroy ]]; then
    echo "Notice: ${STALE//$'\n'/, } are no longer in the stack file. This destroy will destroy them too." >&2
  elif [[ -n "${STALE}" ]]; then
    echo "Error: these generated unit folders are no longer in the stack file:" >&2
    sed 's/^/  /' <<<"${STALE}" >&2
    cat >&2 <<'MSG'

A stack run would run them too. A clean deletes every generated folder, so check them first.
  1. In each folder above, run `terragrunt state list`. If it fails, run `kube-tf init` there, then run it again.
  2. If a folder lists resources, run `terragrunt destroy` in that folder.
  3. When no folder lists resources, run `terragrunt stack clean` in the stack folder.
MSG
    exit 1
  fi
fi

if [[ "${VERB}" == apply || "${VERB}" == destroy ]]; then
  LABEL=$(target_label)
  case "${MODE}" in
    unit) echo "About to ${VERB}: $(pwd)" ;;
    tofu) echo "About to ${VERB} the OpenTofu root: $(pwd)" ;;
    stack) echo "About to ${VERB} ALL units of the stack file in: $(pwd)" ;;
    units)
      mapfile -t UNITS < <(unit_dirs | sed "s|^$(pwd)/||")
      echo "About to ${VERB} ALL ${#UNITS[@]} units under: $(pwd)"
      printf '  %s\n' "${UNITS[@]}"
      ;;
  esac
  echo -n "Type '${LABEL}' to confirm: "
  read -r CONFIRM
  if [[ "${CONFIRM}" != "${LABEL}" ]]; then
    echo "Confirmation did not match. Aborting." >&2
    exit 1
  fi
fi

case "${MODE}:${VERB}" in
  unit:init) exec terragrunt init --backend-bootstrap "$@" ;;
  unit:plan) exec terragrunt plan "$@" ;;
  unit:apply | unit:destroy) exec terragrunt "${VERB}" --backend-bootstrap -auto-approve "$@" ;;

  stack:init | stack:plan | stack:apply | stack:destroy)
    exec terragrunt stack run "${VERB}" --backend-bootstrap --non-interactive "$@"
    ;;

  units:init) exec terragrunt run --all --backend-bootstrap -- init "$@" ;;
  units:plan) exec terragrunt run --all -- plan "$@" ;;
  units:apply | units:destroy)
    exec terragrunt run --all --non-interactive --backend-bootstrap -- "${VERB}" -auto-approve "$@"
    ;;

  tofu:init | tofu:plan) exec tofu "${VERB}" "$@" ;;
  tofu:apply | tofu:destroy) exec tofu "${VERB}" -auto-approve "$@" ;;
esac
