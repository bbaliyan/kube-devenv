#!/usr/bin/env bash
# kube-watch — poll kube-status until bootstrap reports 'complete' or 'failed'.
# Run from the cluster directory (live/<provider>/clusters/<name>/). Prompts
# to pick a node once (multi-node control-plane or node pool), then polls that same
# node throughout: KUBE_SELECTED_NODE is exported so each kube-status
# invocation below reuses the choice instead of re-prompting every interval.
set -euo pipefail
source kube-common.sh

INTERVAL="${KUBE_WATCH_INTERVAL:-15}"
TIMEOUT="${KUBE_WATCH_TIMEOUT:-600}"
ELAPSED=0

terragrunt_outputs
NODE=$(select_node "${TF_OUTPUTS}")
NODE_NAME=$(echo "${NODE}" | jq -r '.name')
export KUBE_SELECTED_NODE="${NODE}"

echo "Watching bootstrap for node '${NODE_NAME}' in $(pwd) (polling every ${INTERVAL}s, timeout ${TIMEOUT}s)..."

while true; do
  STATUS=$(kube-status 2>/dev/null | tr -d '[:space:]' || echo "error")

  printf "[%ds] %s\n" "${ELAPSED}" "${STATUS}"

  case "${STATUS}" in
    complete)
      echo "Bootstrap complete."
      exit 0
      ;;
    failed)
      echo "Bootstrap failed. Run 'kube-status' for details." >&2
      exit 1
      ;;
  esac

  if (( ELAPSED >= TIMEOUT )); then
    echo "Timeout waiting for bootstrap after ${TIMEOUT}s." >&2
    exit 1
  fi

  sleep "${INTERVAL}"
  ELAPSED=$(( ELAPSED + INTERVAL ))
done
