#!/usr/bin/env bash
# kube-destroy — destroy the selected cluster (requires typed confirmation).
# Handles a single terragrunt unit (single-node cluster) and a multi-node
# cluster root, which is destroyed across all its units in reverse dependency
# order with `terragrunt run --all`
# (control-plane and node-pool destroy concurrently first, since neither depends on
# the other; cluster-facts destroys last, since both of them depend on it).
# Run from the cluster directory (live/<provider>/clusters/<name>[/<unit>]/).
set -euo pipefail
source kube-common.sh

MODE=$(terragrunt_run_mode)
CLUSTER_DIR="$(pwd)"
CLUSTER=$(cluster_name_from_pwd)

case "${MODE}" in
  single) echo "About to destroy: ${CLUSTER_DIR}" ;;
  all)    echo "About to destroy ALL units of multi-node cluster '${CLUSTER}': ${CLUSTER_DIR}" ;;
  *)
    echo "Error: '${CLUSTER_DIR}' is neither a terragrunt unit nor a multi-node cluster root." >&2
    exit 1
    ;;
esac

echo -n "Type '${CLUSTER}' to confirm: "
read -r CONFIRM

if [[ "${CONFIRM}" != "${CLUSTER}" ]]; then
  echo "Confirmation did not match. Aborting." >&2
  exit 1
fi

if [[ "${MODE}" == "all" ]]; then
  # --non-interactive suppresses terragrunt's own run-queue prompt; the typed
  # cluster-name confirmation above is our single, deliberate gate. -auto-approve
  # only silences the tofu layer, not terragrunt's run-queue prompt.
  terragrunt run --all --non-interactive -- destroy -auto-approve
else
  terragrunt destroy -auto-approve
fi
