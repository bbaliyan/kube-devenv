#!/usr/bin/env bash
# kube-apply — terragrunt apply for the selected cluster (typed confirmation, auto-approved).
# -auto-approve skips terragrunt's own plan-diff prompt — run 'kube-plan' first
# to review changes. Handles a single terragrunt unit (single-node cluster) and
# a multi-node cluster root, which is applied across all its units in dependency
# order with `terragrunt run --all` (cluster-facts first; control-plane and node-pool
# apply concurrently after that, since neither depends on the other — only on
# cluster-facts).
# Run from the cluster directory (live/<provider>/clusters/<name>[/<unit>]/).
set -euo pipefail
source kube-common.sh

# Ansible's profile_tasks callback prints each task's duration as it runs plus
# a longest-first summary at the end; timer adds total playbook runtime. Only
# takes effect for Proxmox, where node-bootstrap runs ansible-playbook as a
# direct child of this shell (operator_connect mode) — AWS/Azure dispatch
# ansible remotely (SSM/run-command), so this env var never reaches it there.
# Exported unconditionally but overridable: an operator who already sets
# ANSIBLE_CALLBACKS_ENABLED keeps their own value.
export ANSIBLE_CALLBACKS_ENABLED="${ANSIBLE_CALLBACKS_ENABLED:-timer,profile_tasks}"

MODE=$(terragrunt_run_mode)
CLUSTER_DIR="$(pwd)"
CLUSTER=$(cluster_name_from_pwd)

case "${MODE}" in
  single) echo "About to apply: ${CLUSTER_DIR}" ;;
  all)    echo "About to apply ALL units of multi-node cluster '${CLUSTER}': ${CLUSTER_DIR}" ;;
  *)
    echo "Error: '${CLUSTER_DIR}' is neither a terragrunt unit nor a multi-node cluster root." >&2
    exit 1
    ;;
esac

echo -n "Type '${CLUSTER}' to confirm: "
read -r CONFIRM

if [[ "${CONFIRM}" != "${CLUSTER}" ]]; then
  echo "Confirmation did not match. Aborting." >&2
  exit 1
fi

if [[ "${MODE}" == "all" ]]; then
  # --non-interactive suppresses terragrunt's own run-queue prompt; the typed
  # cluster-name confirmation above is our single, deliberate gate. -auto-approve
  # only silences the tofu layer, not terragrunt's run-queue prompt.
  # --backend-bootstrap: see kube-init.
  terragrunt run --all --non-interactive --backend-bootstrap -- apply -auto-approve "$@"
else
  terragrunt apply --backend-bootstrap -auto-approve "$@"
fi
