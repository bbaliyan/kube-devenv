#!/usr/bin/env bash
# kube-kubeconfig — fetch kubeconfig from the node and write it to
# ~/.kube/<cluster>.yaml, or ~/.kube/<cluster>-<region>.yaml for providers
# with a region concept.
# AWS/Azure use an inbound-port-free control-plane primitive (SSM /
# run-command); Proxmox uses direct SSH to the VM (requires port 22 open to
# the node — see live/proxmox/README.md).
# Works whether a single-node cluster, a multi-node cluster root, or a specific
# unit is selected: a multi-node root resolves to its control-plane unit, since
# that is where the kubeconfig/API server lives.
# Run from the cluster directory (live/<provider>/clusters/<name>[/<unit>]/).
set -euo pipefail
source kube-common.sh

resolve_control_plane_unit
terragrunt_outputs
NODE_PROVIDER=$(echo "${TF_OUTPUTS}" | jq -r '.node_provider.value')
NODE_REF=$(echo "${TF_OUTPUTS}"     | jq -r '.node_control_ref.value')
CLUSTER_IP=$(echo "${TF_OUTPUTS}"   | jq -r '.cluster_ip.value')
CLUSTER_FQDN=$(echo "${TF_OUTPUTS}" | jq -r '.cluster_fqdn.value // empty')
# Prefer the DNS name so kubeconfig TLS validation works against the cert SAN.
SERVER="${CLUSTER_FQDN:-$CLUSTER_IP}"
CLUSTER_NAME=$(cluster_name_from_pwd)
# KUBECONFIG_STEM names both the output file and, via rewrite_kubeconfig, the
# context/cluster/user inside it. Defaults to the cluster name; providers with
# a region concept append it below so same-named clusters in different
# regions get distinct files and don't collide if their kubeconfigs are ever
# merged. Proxmox has no region concept, so it keeps the plain name.
KUBECONFIG_STEM="${CLUSTER_NAME}"

echo "Fetching kubeconfig for cluster '${CLUSTER_NAME}' (${NODE_PROVIDER})..."

case "${NODE_PROVIDER}" in

  proxmox)
    VM_SSH_KEY=$(proxmox_vm_ssh_key)
    VM_SSH_USER=$(proxmox_vm_ssh_user)
    KUBECONFIG_PATH="${HOME}/.kube/${KUBECONFIG_STEM}.yaml"
    # UserKnownHostsFile=/dev/null: see the identical comment in kube-shell —
    # clusters here are deliberately disposable, so a rotated host key on
    # every destroy/recreate at the same static IP is expected, not
    # suspicious.
    ssh -i "${VM_SSH_KEY}" -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null \
        "${VM_SSH_USER}@${CLUSTER_IP}" \
        "cat /etc/rancher/rke2/rke2.yaml" \
    | rewrite_kubeconfig "${SERVER}" "${KUBECONFIG_STEM}" \
    > "${KUBECONFIG_PATH}"
    ;;

  aws)
    AWS_REGION=$(echo "${TF_OUTPUTS}" | jq -r '.aws_region.value')
    KUBECONFIG_STEM="${CLUSTER_NAME}-${AWS_REGION}"
    KUBECONFIG_PATH="${HOME}/.kube/${KUBECONFIG_STEM}.yaml"
    remove_stale_unsuffixed_kubeconfig "${CLUSTER_NAME}"
    aws ssm send-command \
      --instance-ids "${NODE_REF}" \
      --region "${AWS_REGION}" \
      --document-name "AWS-RunShellScript" \
      --parameters 'commands=["cat /etc/rancher/rke2/rke2.yaml"]' \
      --query "Command.CommandId" --output text \
    | xargs -I{} aws ssm get-command-invocation \
        --instance-id "${NODE_REF}" --region "${AWS_REGION}" --command-id {} \
        --query "StandardOutputContent" --output text \
    | rewrite_kubeconfig "${SERVER}" "${KUBECONFIG_STEM}" \
    > "${KUBECONFIG_PATH}"
    ;;

  azure)
    RESOURCE_GROUP=$(echo "${TF_OUTPUTS}" | jq -r '.resource_group_name.value')
    AZURE_REGION=$(echo "${TF_OUTPUTS}" | jq -r '.azure_region.value // empty')
    if [[ -n "${AZURE_REGION}" ]]; then
      KUBECONFIG_STEM="${CLUSTER_NAME}-${AZURE_REGION}"
      remove_stale_unsuffixed_kubeconfig "${CLUSTER_NAME}"
    fi
    KUBECONFIG_PATH="${HOME}/.kube/${KUBECONFIG_STEM}.yaml"
    VM_NAME=$(basename "${NODE_REF}")
    az vm run-command invoke \
      --resource-group "${RESOURCE_GROUP}" \
      --name "${VM_NAME}" \
      --command-id RunShellScript \
      --scripts "cat /etc/rancher/rke2/rke2.yaml" \
      --query "value[0].message" --output tsv \
    | rewrite_kubeconfig "${SERVER}" "${KUBECONFIG_STEM}" \
    > "${KUBECONFIG_PATH}"
    ;;

  *)
    echo "Error: unknown node_provider '${NODE_PROVIDER}'" >&2
    exit 1
    ;;
esac

chmod 600 "${KUBECONFIG_PATH}"
echo "Written to ${KUBECONFIG_PATH}"
echo ""
echo "To use:"
echo "  export KUBECONFIG=${KUBECONFIG_PATH}"
echo "  kubectl get nodes"
