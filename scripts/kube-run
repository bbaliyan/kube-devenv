#!/usr/bin/env bash
# kube-run — cd to the selected cluster directory and run a kube-* verb.
# Used by VS Code task buttons so each task dispatches to the persisted cluster.
set -euo pipefail
source kube-common.sh

CLUSTER_DIR=$(selected_cluster_dir)

echo "→ $(basename "${CLUSTER_DIR}")"
cd "${CLUSTER_DIR}"
exec "$@"
