#!/usr/bin/env bash
# kube-shell — break-glass shell session on a node.
# AWS/Azure use an inbound-port-free control-plane primitive (SSM /
# run-command); Proxmox uses direct SSH to the VM (requires port 22 open to
# the node — see live/proxmox/README.md).
# Run from either a specific unit (live/<provider>/clusters/<name>/[control-plane|
# node-pools/<pool>]/) or a multi-node cluster root (live/<provider>/clusters/<name>/)
# — select_node_any_unit aggregates nodes across every unit in the latter case.
# Prompts to pick a node whenever there's more than one across whatever's in scope.
set -euo pipefail
source kube-common.sh

NODE=$(select_node_any_unit)
NODE_NAME=$(echo "${NODE}" | jq -r '.name')
NODE_IP=$(echo "${NODE}" | jq -r '.ip // empty')
NODE_INSTANCE_ID=$(echo "${NODE}" | jq -r '.instance_id')
NODE_PROVIDER=$(echo "${NODE}" | jq -r '.provider')
NODE_UNIT=$(echo "${NODE}" | jq -r '.unit')
cd "${NODE_UNIT}"

case "${NODE_PROVIDER}" in

  proxmox)
    VM_SSH_KEY=$(proxmox_vm_ssh_key)
    VM_SSH_USER=$(proxmox_vm_ssh_user)
    echo "Opening shell on ${NODE_NAME} (${NODE_IP}) as ${VM_SSH_USER}..."
    # UserKnownHostsFile=/dev/null: clusters here are deliberately disposable
    # (destroy/recreate at a stable static IP is the normal operating model),
    # so a rotated host key on every recreate is expected, not suspicious —
    # without this, a recreate hits "REMOTE HOST IDENTIFICATION HAS CHANGED"
    # against the operator's real known_hosts. Same deliberate trade-off as
    # kube-compute's node-bootstrap Ansible connection.
    ssh -i "${VM_SSH_KEY}" -t -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/dev/null "${VM_SSH_USER}@${NODE_IP}"
    ;;

  aws)
    AWS_REGION=$(terragrunt output -raw aws_region)
    echo "Starting SSM session on ${NODE_NAME} (${NODE_INSTANCE_ID}) in ${AWS_REGION}..."
    aws ssm start-session --target "${NODE_INSTANCE_ID}" --region "${AWS_REGION}"
    ;;

  azure)
    RESOURCE_GROUP=$(terragrunt output -raw resource_group_name)
    VM_NAME=$(basename "${NODE_INSTANCE_ID}")
    echo "Starting Azure run-command shell on ${NODE_NAME} (${VM_NAME})..."
    echo "(Azure run-command is non-interactive — use 'az serial-console' for a live session)"
    az vm run-command invoke \
      --resource-group "${RESOURCE_GROUP}" \
      --name "${VM_NAME}" \
      --command-id RunShellScript \
      --scripts "${*:-bash}"
    ;;

  *)
    echo "Error: unknown node_provider '${NODE_PROVIDER}'" >&2
    exit 1
    ;;
esac
