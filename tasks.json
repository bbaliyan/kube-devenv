{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "$(tag) Select Cluster",
      "type": "shell",
      "command": "select-cluster",
      "presentation": { "reveal": "always", "panel": "dedicated", "close": false },
      "problemMatcher": []
    },
    {
      "label": "$(key) Cloud Login",
      "type": "shell",
      "command": "kube-cloud-login",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(run-all) Init",
      "type": "shell",
      "command": "kube-run kube-init",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(play) Apply",
      "type": "shell",
      "command": "kube-run kube-apply",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(debug-start) Start Node",
      "detail": "Start one stopped node, or all of them. Only needed when resuming a stopped cluster.",
      "type": "shell",
      "command": "kube-run kube-start",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(output) Tail",
      "detail": "Live-tail a node's bootstrap log. Apply returns before a node finishes joining.",
      "type": "shell",
      "command": "kube-run kube-tail",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(plug) Kubeconfig",
      "type": "shell",
      "command": "kube-run kube-kubeconfig",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(shield) Secrets",
      "type": "shell",
      "command": "kube-run kube-secrets",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(terminal) Shell",
      "type": "shell",
      "command": "kube-run kube-shell",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(debug-stop) Stop Node",
      "detail": "Stop one node, or all of them, rather than waiting for a schedule. Start Node brings them back.",
      "type": "shell",
      "command": "kube-run kube-stop",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(sync) Patch OS",
      "providers": ["proxmox"],
      "detail": "Patches every node's OS (Proxmox only) — control-plane one at a time, then workers. Prompts to confirm the cluster name.",
      "type": "shell",
      "command": "kube-run kube-os-patch",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "$(trash) Destroy",
      "type": "shell",
      "command": "kube-run kube-destroy",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
