{
  // kube-devenv reference devcontainer — copy to your consumer repo's .devcontainer/
  //
  // Replace the image digest below with the one from the release you want to pin:
  //   docker pull ghcr.io/bbaliyan/kube-devenv:v0.1.0
  //   docker inspect ghcr.io/bbaliyan/kube-devenv:v0.1.0 --format '{{index .RepoDigests 0}}'
  //
  // Renovate will keep the digest current via automated PRs once configured.
  //
  // renovate: datasource=docker depName=ghcr.io/bbaliyan/kube-devenv
  "image": "ghcr.io/bbaliyan/kube-devenv:v0.1.0@sha256:<digest>",
  "name": "kube-devenv",

  // Merge base tasks with any consumer-defined tasks-custom.json on every container start.
  // .vscode/tasks.json is gitignored — it stays up-to-date with the image.
  "initializeCommand": "mkdir -p ~/.aws ~/.kube ~/.config/age ~/.kube-node",
  "postStartCommand": "kube-tasks-merge",
  "postCreateCommand": {
    "pre-commit": "pre-commit install || true",
    // Source ~/.kube-node/proxmox in every terminal so a token refreshed via
    // `kube-proxmox-login` is picked up without a manual source. No-op until
    // the token file exists.
    "token": "grep -q '.kube-node/proxmox' ~/.bashrc || echo 'test -f /root/.kube-node/proxmox && source /root/.kube-node/proxmox' >> ~/.bashrc"
  },

  // Mount host credentials read-only; .kube and .kube-node writable so
  // kube-kubeconfig / kube-proxmox-login can write.
  "mounts": [
    "source=${localEnv:HOME}/.aws,target=/root/.aws,type=bind,readonly",
    "source=${localEnv:HOME}/.kube,target=/root/.kube,type=bind",
    "source=${localEnv:HOME}/.config/age,target=/root/.config/age,type=bind,readonly",
    // ~/.kube-node holds the Proxmox API token outside the repo tree — never
    // in the IDE file tree or git status. Populated by `kube-proxmox-login`.
    "source=${localEnv:HOME}/.kube-node,target=/root/.kube-node,type=bind",
    // Forward the SSH agent so kube-status/kube-kubeconfig/kube-proxmox-login
    // can reach the Proxmox host.
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent,type=bind"
  ],

  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "WORKSPACE_FOLDER": "${containerWorkspaceFolder}",
    // Proxmox: non-sensitive endpoint URL, set in your shell profile.
    // PROXMOX_VE_API_TOKEN is NOT forwarded here — it expires after 8h and a
    // one-time env forward can't be refreshed without a container rebuild.
    // Run `kube-proxmox-login` instead; it's picked up via the mount above.
    "PROXMOX_VE_ENDPOINT": "${localEnv:PROXMOX_VE_ENDPOINT}"
    // AWS: forwarded automatically via the .aws mount above.
    // Azure: set ARM_* vars or use 'az login' inside the container.
  },

  "remoteUser": "root",

  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "mhutchie.git-graph",
        "actboy168.tasks",
        "foxundermoon.shell-format"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[terraform]": { "editor.defaultFormatter": "hashicorp.terraform" },
        "[yaml]":      { "editor.defaultFormatter": "redhat.vscode-yaml" },
        "[shellscript]": {
          "editor.defaultFormatter": "foxundermoon.shell-format",
          "shellformat.flag": "-i 2 -ci"
        },
        "[json]":  { "editor.defaultFormatter": "redhat.vscode-yaml" },
        "[jsonc]": { "editor.defaultFormatter": "redhat.vscode-yaml" }
      }
    }
  }
}
